# Copy this file to .env
PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017/chatapp
SECRET=replace-with-a-long-random-string
# Optional, cloudinary://<api key>:<api secret>@<cloud name>. Without it pictures are stored in MongoDB
CLOUDINARY_URL=
# Frontend origins allowed to use the API, comma separated
CLIENT_URL=http://localhost:3000
